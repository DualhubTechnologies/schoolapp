# SchoolHub for Windows (APP_EDITION=desktop): one school, on one computer,
# working without internet. The Windows installer (NativePHP) uses these;
# copy to .env to try the desktop edition with `php artisan serve`.
APP_NAME=SchoolHub
APP_EDITION=desktop
APP_ENV=production
APP_DEBUG=false
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=Africa/Kampala
APP_KEY=

# Everything is kept in one file on this computer.
DB_CONNECTION=sqlite
DB_DATABASE=

# No servers to rely on.
SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# Email needs internet; until the school sets it up, messages go to the log.
MAIL_MAILER=log

# SMS: with Africa's Talking set up, texts written while offline wait in the
# outbox and go out once the computer is online (sms:send-queued).
SMS_DRIVER=log
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
AFRICASTALKING_SENDER_ID=

# Checks licence keys (not secret): the public key printed by
# `php artisan licence:keygen` on the online server.
LICENCE_PUBLIC_KEY=GVdvAk4enebTPFszl3URZx+TUysX1OJ/eI1Wefwrr3I=
